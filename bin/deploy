#!/bin/bash
# Copy config, rules, prompts and the built shortcuts into iCloud Drive/Shortcuts/EmailTriage.
#
# Your own settings live in local/ (gitignored): local/config.json, local/rules.json and
# local/prompts/*.txt. When a file exists in local/, it is deployed. Otherwise the public
# example (icloud/config.example.json, icloud/rules.example.json, icloud/prompts/*.txt) is
# copied only if iCloud doesn't have that file yet, so a deploy never overwrites your own.
# The phone's logs and feedback files are left alone.
set -euo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"
dest="${INBOX_TRIAGE_DEST:-$HOME/Library/Mobile Documents/iCloud~is~workflow~my~workflows/Documents/EmailTriage}"
localdir="${INBOX_TRIAGE_LOCAL:-$repo/local}"

# rules.json can change in two places: local/ (bin/learn, an editor) and iCloud (rules approved on the
# review page). local/.deployed-rules.sha remembers what was last deployed, so a phone change is pulled into
# local/ (and committed there when local/ is a git repo) instead of being overwritten. If both changed, stop.
sha() { shasum -a 256 < "$1" | cut -c1-64; }
pull_rules() {
  local icloud="$dest/rules.json" mine="$localdir/rules.json" mark="$localdir/.deployed-rules.sha"
  [ -f "$icloud" ] && [ -f "$mine" ] || return 0
  command -v brctl >/dev/null && brctl download "$icloud" >/dev/null 2>&1 || true
  local ih lh last
  ih="$(sha "$icloud")"; lh="$(sha "$mine")"; last="$(cat "$mark" 2>/dev/null || true)"
  if [ "$ih" = "$lh" ]; then echo "$lh" > "$mark"; return 0; fi
  if [ -n "$last" ] && [ "$ih" = "$last" ]; then return 0; fi          # only local/ changed: deploy it
  if [ -n "$last" ] && [ "$lh" = "$last" ]; then                       # only the phone changed: pull it
    cp "$icloud" "$mine"
    echo "$ih" > "$mark"
    if git -C "$localdir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      git -C "$localdir" add rules.json && git -C "$localdir" commit -q -m "rules.json: rules approved on the phone" || true
      # Keep the private backup current when local/ has a remote (a private repo). Best effort.
      if git -C "$localdir" remote get-url origin >/dev/null 2>&1; then
        git -C "$localdir" push -q origin HEAD >/dev/null 2>&1 || echo "Couldn't push local/ to its backup remote." >&2
      fi
    fi
    echo "Pulled rules.json from iCloud (approved on the phone) into $mine."
    return 0
  fi
  echo "rules.json differs between iCloud and $mine, and it isn't clear which is newer." >&2
  echo "Compare: diff \"$icloud\" \"$mine\"" >&2
  echo "Keep one by copying it over the other, then run bin/deploy again." >&2
  exit 1
}
pull_rules
[ "${1:-}" = "--pull-rules" ] && exit 0
mkdir -p "$dest/prompts" "$dest/log" "$dest/feedback"

# place <personal file> <example file> <destination>
place() {
  if [ -f "$1" ]; then
    rsync -a --checksum "$1" "$3"
  elif [ ! -e "$3" ]; then
    cp "$2" "$3"
    echo "Seeded $(basename "$3") from the example. Edit local/ for your own settings."
  fi
}

place "$localdir/config.json" "$repo/icloud/config.example.json" "$dest/config.json"
place "$localdir/rules.json" "$repo/icloud/rules.example.json" "$dest/rules.json"
[ -f "$localdir/rules.json" ] && sha "$localdir/rules.json" > "$localdir/.deployed-rules.sha"
for f in "$repo"/icloud/prompts/*.txt; do
  name="$(basename "$f")"
  place "$localdir/prompts/$name" "$f" "$dest/prompts/$name"
done

# Files the shortcuts read at run time: create them empty if missing, never overwrite.
for f in feedback/applied.txt feedback/pending.tsv; do
  [ -e "$dest/$f" ] || : > "$dest/$f"
done

for f in "$repo"/build/*.shortcut; do
  case "$f" in *.unsigned.shortcut) continue ;; esac
  # cp, not rsync -a: Files should show the deploy time, so a new build is easy to tell apart.
  [ -f "$f" ] && cp "$f" "$dest/"
done
echo "Deployed to $dest"
